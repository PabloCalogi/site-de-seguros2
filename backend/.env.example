PORT=3000
NODE_ENV=development

# Segredo usado para assinar os tokens JWT (troque em produção!)
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# Segredo do token de recuperação de senha
RESET_TOKEN_EXPIRES_IN=1h

# Caminho do arquivo do banco SQLite
DB_PATH=./data/varginha_seguros.db

# Origem(ns) permitida(s) para CORS (separadas por vírgula). Use * em dev.
CORS_ORIGIN=*
